Package: plssempower
Type: Package
Title: Power and Sensitivity Analysis for PLS-SEM
Version: 1.2.0
Authors@R: 
    person(
      given = "Alessandro",
      family = "Ansani",
      email = "alessandro.a.ansani@jyu.fi",
      role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0000-0002-0657-5732")
